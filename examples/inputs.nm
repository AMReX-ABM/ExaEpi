# the maximum size of each box - a smaller number increases the number of boxes and hence improves load balance,
# but is worse for GPUs because there is less work per kernel launch
# agent.max_grid_size = 20

# these are settings for the Census input type
#agent.ic_type = "census"
agent.census_filename = "../../CensusData/NM_TX_2010.dat"
agent.workerflow_filename = "../../CensusData/US-wf.bin"

agent.airports_filename="../../CensusData/CA_airports.dat"
agent.air_traffic_filename= "../../CA_CY23AirTraffic.dat"

agent.air_travel_int = 0

agent.initial_case_type = "file"
agent.case_filename = "nm-july4.cases"
#agent.case_filename = "nm-small.cases"

#agent.initial_case_type="random"
#agent.num_initial_cases=1000

# Settings for the UrbanPop input type
agent.ic_type = "urbanpop"
agent.urbanpop_filename = "urbanpop_nm"

agent.nsteps = 70
agent.plot_int = -1
agent.random_travel_int = 0

agent.aggregated_diag_int = -1

#agent.nborhood_size = 500
#agent.workgroup_size = 20

agent.seed = 11

diag.output_filename = "output.dat"

contact.pSC  = 0.2
contact.pCO  = 1.45
contact.pNH  = 1.45
contact.pWO  = 0.5
contact.pFA  = 1.0
contact.pBAR = -1.

disease.nstrain = 2
disease.p_trans = 0.20 0.30
disease.p_asymp = 0.40 0.40
disease.reduced_inf = 0.75 0.75
disease.reinfect_prob = 0.0
