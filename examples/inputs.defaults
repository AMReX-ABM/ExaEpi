# This file lists every recognized runtime parameter, set to its default value where one
# exists. Parameters with no default (marked "no default") must be set explicitly, at least
# under the conditions noted. This list is generated from -- and should always match --
# `./agent --help`, which reads these same defaults live from the code.

## ---------------------------------------------------------------------------------------
## agent.* -- overall simulation
## ---------------------------------------------------------------------------------------

# Number of simulation steps (days).
agent.nsteps = 1
# Plot file interval, in steps; <=0 disables.
agent.plot_int = -1
# Checkpoint file interval, in steps; <=0 disables.
agent.check_int = -1
# Interval between random travel events, in steps; <=0 disables.
agent.random_travel_int = -1
# Probability of an agent going on random travel in each event.
agent.random_travel_prob = 0.0001
# Interval between air travel events, in steps; <=0 disables.
agent.air_travel_int = -1
# Number of diseases to track.
agent.number_of_diseases = 1
# Names of the diseases (one per agent.number_of_diseases). Defaults to default00, default01, ...
agent.disease_names = default00
# Interval for weather effects, in steps; <=0 disables.
agent.weather_int = -1
# Weather data file. No default; must be set if agent.weather_int > 0.
# agent.weather_filename =
# Simulation start date (YYYY-MM-DD). Only meaningful if agent.weather_int > 0.
agent.startdate = ""
# The UrbanPop data file. Do not include the extension -- there must be two files alongside
# it, with extensions .csv and .idx. No default; always required.
# agent.urbanpop_filename =
# Air traffic flow file. No default; must be set if agent.air_travel_int > 0.
# agent.air_traffic_filename =
# Airports file (which counties each airport serves). No default; must be set if
# agent.air_travel_int > 0.
# agent.airports_filename =
# Optional per-(state, NAICS-code) work-group target size table (see
# utilities/UrbanPop-scripts/compute_workgroup_sizes.py). Falls back to agent.workgroup_size
# for any (state, NAICS) pair not in the file. Empty disables it entirely.
agent.workgroup_size_filename = ""
# Enable population-size-based transmission scaling (keeps community/neighborhood
# transmission frequency-dependent rather than density-dependent).
agent.size_scale_enabled = true
# Fallback target students-per-class, for raw (community, school, grade) groups with no
# identified teachers.
agent.school_class_size = 20
# Floor on average class size (bounds class count from above).
agent.school_class_size_min = 5
# Cap on average class size (bounds class count from below).
agent.school_class_size_max = 50
# Correction factor applied to a college-level raw group's reported teacher/staff headcount
# (which is a total-employment figure, not faculty-specific) before it drives class count.
agent.college_instructional_fraction = 0.1
# Maximum box size used for MPI domain decomposition.
agent.max_box_size = 16
# Interval for writing aggregated diagnostic data, in steps; <=0 disables.
agent.aggregated_diag_int = -1
# Filename prefix for aggregated diagnostic output.
agent.aggregated_diag_prefix = cases
# Checkpoint file to restart from. Empty means start fresh.
agent.restart = ""
# Step at which to start shelter-in-place; <=0 disables.
agent.shelter_start = -1
# Number of steps shelter-in-place lasts.
agent.shelter_length = 0
# Target neighborhood size (number of agents).
agent.nborhood_size = 360
# Target workgroup size (number of agents).
agent.workgroup_size = 20
# RNG seed. No default -- if unset, AMReX's own default seeding is used.
# agent.seed =
# Use faster, non-bitwise-reproducible implementations (e.g. binning).
agent.fast = false
# Attribute infections to interaction contexts and write per-context columns to the output file.
agent.context_diag = false
# Shelter-in-place compliance rate (probability an agent actually shelters).
agent.shelter_compliance = 0.95
# Symptomatic-withdrawal compliance rate on the 1st/2nd/3rd+ day of symptoms, by age group
# (u5, 5-17, 18-29, 30-49, 50-64, 65+).
agent.symptomatic_withdraw_compliance_day_0 = 0.3 0.3 0.3 0.3 0.3 0.3
agent.symptomatic_withdraw_compliance_day_1 = 0.8 0.7 0.5 0.5 0.5 0.5
agent.symptomatic_withdraw_compliance_day_2 = 0.9 0.8 0.7 0.7 0.7 0.7

## ---------------------------------------------------------------------------------------
## diag.* -- output file naming
## ---------------------------------------------------------------------------------------

# Output filename(s) for per-day status counts, one per disease. Defaults to output.dat for
# a single disease, or output_<disease name>.dat per disease for multiple diseases.
diag.output_filename = output.dat

## ---------------------------------------------------------------------------------------
## disease.* -- common to all diseases. With multiple diseases, every key below may be
## overridden per-disease as disease_<disease name>.<key> (disease_name from
## agent.disease_names), which takes precedence over disease.<key>.
## ---------------------------------------------------------------------------------------

# How initial cases are seeded: "random" or "file".
disease.initial_case_type = random
# Initial cases file: FIPS code, current cases, cumulative cases. No default; must be set
# if initial_case_type = file.
# disease.case_filename =
# Number of initial cases (used only if initial_case_type = random).
disease.num_initial_cases = 0
# Community transmission probability, by age group of the receiving agent
# (u5, 5-17, 18-29, 30-49, 50-64, 65+).
disease.xmit_comm = 0.000021 0.000062 0.000165 0.000165 0.000165 0.000247
# Overall magnitude of community transmission (population-size-scaled; see
# agent.size_scale_enabled). Does not affect disease.xmit_hood.
disease.xmit_comm_scale = 1
# Neighborhood transmission probability, by age group of the receiving agent.
disease.xmit_hood = 0.000082 0.000247 0.00066 0.00066 0.00066 0.00099
# Within-household transmission probability, transmitter is an adult, by age group of the
# receiving agent.
disease.xmit_hh_adult = 0.3 0.3 0.4 0.4 0.4 0.4
# Within-household transmission probability, transmitter is a child.
disease.xmit_hh_child = 0.6 0.6 0.3 0.3 0.3 0.3
# Neighborhood-cluster transmission probability, transmitter is an adult.
disease.xmit_nc_adult = 0.132 0.132 0.165 0.165 0.165 0.165
# Neighborhood-cluster transmission probability, transmitter is a child.
disease.xmit_nc_child = 0.25 0.25 0.132 0.132 0.132 0.132
# Child-to-child school transmission probability, by school type
# (none, college, high, middle, elem, daycare). The first entry is ignored.
disease.xmit_school = 0 0.441 0.441 0.525 0.609 0.15
# Adult-to-child school transmission probability, by school type.
disease.xmit_school_a2c = 0 0.2 0.2 0.25 0.3 0.3
# Child-to-adult school transmission probability, by school type.
disease.xmit_school_c2a = 0 0.2 0.2 0.25 0.3 0.3
# Overall scale factor applied to all disease.xmit_school* values.
disease.xmit_school_scale = 0.27
# Workgroup transmission probability.
disease.xmit_work = 0.13
# Probability of transmission given contact.
disease.p_trans = 0.1
# Fraction of cases that are asymptomatic.
disease.p_asymp = 0.3
# Relative infectiousness of asymptomatic individuals.
disease.asymp_relative_inf = 0.7
# Vaccine efficacy. Not yet implemented; must be left at 0.
disease.vac_eff = 0
# Compliance rate for children when schools are closed (reduces neighborhood transmission).
# NOTE: currently has no effect -- DiseaseParm::initialize() unconditionally overwrites this
# to 0.5 regardless of what is set here.
disease.child_compliance = 0.5
# Factor for increasing within-household transmission by children when schools are closed.
# NOTE: currently has no effect -- DiseaseParm::initialize() unconditionally overwrites this
# to 2.0 regardless of what is set here.
disease.child_hh_closure = 2.0
# Sample latent/incubation/infectious periods from Epicast's fixed CDFs instead of the Gamma
# distributions below.
disease.compare_to_epicast = false
# Gamma distribution alpha/beta for latent period length (time from infection until
# infectious). Mean = alpha*beta, variance = alpha*beta^2.
disease.latent_length_alpha = 2.77
disease.latent_length_beta = 1.5
# Gamma distribution alpha/beta/loc for infectious period length (time infectious, starting
# once the latent phase ends). loc is a location (shift) applied to the sampled value.
disease.infectious_length_alpha = 3.54
disease.infectious_length_beta = 1.22
disease.infectious_length_loc = 2.75
# Gamma distribution alpha/beta/loc for incubation period length (time from infection until
# symptoms appear).
disease.incubation_length_alpha = 2.77
disease.incubation_length_beta = 1.5
disease.incubation_length_loc = 0.85
# Gamma distribution alpha/beta/loc for hospital admission delay (time from symptom onset
# until an agent seeks treatment).
disease.hospital_delay_length_alpha = 0.0
disease.hospital_delay_length_beta = 0.0
disease.hospital_delay_length_loc = 2.0
# Gamma distribution alpha/beta/loc for immunity period length (time immune after recovery).
disease.immune_length_alpha = 1000.0
disease.immune_length_beta = 1.0
disease.immune_length_loc = 1000.0
# Hospital stay length model: "constant" or "random".
disease.hospital_stay_type = constant
# Hospital stay length in days, by age group. Used only if hospital_stay_type = constant.
disease.hospitalization_days = 3 3 3 3 8 7
# Gamma distribution alpha/beta for hospital stay length, by age group. Used only if
# hospital_stay_type = random.
disease.hospitalization_days_alpha = 3 3 3 3 8 7
disease.hospitalization_days_beta = 1 1 1 1 1 1
# Symptomatic -> hospitalized probability, by age group.
disease.CHR = 0.0104 0.0104 0.070 0.28 0.28 1.0
# Hospitalized -> ICU probability, by age group.
disease.CIC = 0.24 0.24 0.24 0.36 0.36 0.35
# ICU -> ventilator probability, by age group.
disease.CVE = 0.12 0.12 0.12 0.22 0.22 0.22
# Probability of dying in hospital (non-ICU), by age group.
disease.hospCVF = 0 0 0 0 0 0
# Probability of dying in ICU (non-ventilated), by age group.
disease.icuCVF = 0 0 0 0 0 0.26
# Probability of dying while ventilated, by age group.
disease.ventCVF = 0.20 0.20 0.20 0.45 0.45 1.0

## ---------------------------------------------------------------------------------------
## disease_coupling.* -- only relevant if agent.number_of_diseases > 1
## ---------------------------------------------------------------------------------------

# Co-immunity matrix (number_of_diseases x number_of_diseases, row-major): immunity to
# disease j conferred by recovery from disease i. Default: identity (1.0 on the diagonal,
# 0.0 off-diagonal).
# disease_coupling.coimmunity_matrix =
# Co-susceptibility matrix (number_of_diseases x number_of_diseases, row-major):
# susceptibility to disease j while currently infected with i. Default: all 1.0.
# disease_coupling.cosusceptibility_matrix =

## ---------------------------------------------------------------------------------------
## amrex.* / particles.* -- ExaEpi-adjusted AMReX defaults (see main.cpp,
## overrideAmrexDefaults()); any other AMReX runtime parameter can also be set here, see
## https://amrex-codes.github.io/amrex/docs_html/GPU.html#inputs-parameters
## ---------------------------------------------------------------------------------------

# Whether AMReX's default Arena uses managed memory. ExaEpi does not require it.
amrex.the_arena_is_managed = false
# Whether AMReX uses a dedicated comms arena.
amrex.use_comms_arena = true
# Whether to tile particle iteration. Defaults to true on CPU builds, false on GPU builds.
particles.do_tiling = true
